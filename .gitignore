# ---- Ghost runtime (installed via `ghost install local`) ----
# Never commit the running Ghost instance: it contains the SQLite database,
# uploaded media, logs and generated config that must stay out of Git.
runtime/

# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Secrets & local config ----
.env
.env.*
!.env.example
config.production.json
*.secret

# ---- Logs & databases ----
*.log
logs/
*.sqlite
*.sqlite3
*.db

# ---- Theme build sourcemaps (regenerated by `gulp`) ----
theme/oss-blog-theme/assets/built/*.map

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Data export (contains member PII — do not commit raw exports) ----
exports/
*.ghost.json
