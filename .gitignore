# ---- Ghost runtime (installed via `ghost install local`) ----
# Never commit the running Ghost instance: it contains the SQLite database,
# uploaded media, logs and generated config that must stay out of Git.
runtime/

# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Secrets & local config ----
.env
.env.*
!.env.example
config.production.json
*.secret

# ---- Logs & databases ----
*.log
logs/
*.sqlite
*.sqlite3
*.db

# ---- Theme build sourcemaps (regenerated by `gulp`) ----
theme/oss-blog-theme/assets/built/*.map

# ---- Theme zip build output (regenerate via `gulp zip`) ----
theme/oss-blog-theme/dist/

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Local ssh deploy keys (never commit; rotate + re-add to GitHub on new machines) ----
.ssh/

# ---- Data export (contains member PII — do not commit raw exports) ----
exports/
*.ghost.json

# generated static snapshot (GitHub Pages)
/static-site/

# ---- Local verification screenshots & scratch (do not commit) ----
/shot-*.png
*.clipboard-*.png
/*.简历项目说明.md
